# Copy this file to .env and paste your Groq API key after the equals sign.
GROQ_API_KEY=

# The model assignments from your Groq model list.
CHEAP_MODEL=openai/gpt-oss-20b
STRONG_MODEL=openai/gpt-oss-120b

# Groq's OpenAI-compatible API endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Neon connection string; database logging will use this later.
DATABASE_URL=

# Optional API protection. Leave empty for unrestricted local development.
ROUTEWISE_API_KEYS=
ROUTEWISE_RATE_LIMIT=60
